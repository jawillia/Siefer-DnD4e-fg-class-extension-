  <windowclass name="reference_classpower_listitem">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));

        <!-- If the description of the list item node is blank but it has shortcut data, make the list item shortcut connect directly to that shortcut -->
        local node = getDatabaseNode();
        if node then
          local sClass, sRecord = DB.getValue(node, "link", "", "");
          if sClass == "powerdesc" then
            local sLocalDescriptionText = DB.getText(node, "description");
            if not sLocalDescriptionText or sLocalDescriptionText == "" then
              local sLinkedPowerDescriptionText = DB.getText(DB.getPath(sRecord, "description"));
              self.link.setValue(DB.getValue(node, "link", "", ""));
            end
          end
        end
      end
      function onLockModeChanged(bReadOnly)
        local tControls = { "name", "idelete", };
        WindowManager.callSafeControlsSetLockMode(self, tControls, bReadOnly);
      end
    </script>
